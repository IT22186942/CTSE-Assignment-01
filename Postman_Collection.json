{
  "info": {
    "name": "Smart Campus Service System",
    "description": "Postman collection for testing all microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3001/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["health"]
            }
          }
        },
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.environment.set('userId', pm.response.json().userId);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \"name\": \"Test Student\",\\n  \"email\": \"student@campus.com\",\\n  \"password\": \"password123\"\\n}"
            },
            "url": {
              "raw": "http://localhost:3001/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.environment.set('token', pm.response.json().token);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \"email\": \"student@campus.com\",\\n  \"password\": \"password123\"\\n}"
            },
            "url": {
              "raw": "http://localhost:3001/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Verify Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3001/auth/verify",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["auth", "verify"]
            }
          }
        }
      ]
    },
    {
      "name": "Request Service",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3002/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3002",
              "path": ["health"]
            }
          }
        },
        {
          "name": "Create Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \"title\": \"Fix AC in Hostel Building\",\\n  \"description\": \"Air conditioning not working in Room 205. Making it very uncomfortable.\",\\n  \"type\": \"maintenance\"\\n}"
            },
            "url": {
              "raw": "http://localhost:3002/request",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3002",
              "path": ["request"]
            }
          }
        },
        {
          "name": "Get All Requests",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3002/request",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3002",
              "path": ["request"]
            }
          }
        },
        {
          "name": "Get User Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3002/request/{{userId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3002",
              "path": ["request", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Notification Service",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3003/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["health"]
            }
          }
        },
        {
          "name": "Get All Notifications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3003/notify",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["notify"]
            }
          }
        },
        {
          "name": "Get User Notifications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3003/notify/{{userId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["notify", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Logging Service",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3004/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3004",
              "path": ["health"]
            }
          }
        },
        {
          "name": "Get All Logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3004/log",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3004",
              "path": ["log"]
            }
          }
        },
        {
          "name": "Get Service Logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3004/log/request-service",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3004",
              "path": ["log", "request-service"]
            }
          }
        },
        {
          "name": "Get User Logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3004/log/user/{{userId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3004",
              "path": ["log", "user", "{{userId}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ]
}
